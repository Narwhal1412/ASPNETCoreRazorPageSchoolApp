        <Field Name="CourseTitle"><DataField>CourseTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Department"><DataField>Department</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Credits"><DataField>Credits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Grade"><DataField>Grade</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
